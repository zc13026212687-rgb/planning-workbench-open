<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PlanningStudio</AssemblyName>
    <RootNamespace>PlanningStudio</RootNamespace>
    <Version>0.2.0</Version>
    <Product>清规AI · PlanningWorkbench Open</Product>
    <Description>Local planning and editable CAD teaching workbench</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
