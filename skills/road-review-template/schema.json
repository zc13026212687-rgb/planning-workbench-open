{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Road teaching input contract (enforced before registered geometry execution)",
  "type": "object",
  "required": ["units", "coordinate_reference", "width_semantics", "roads"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "units": {"enum": ["m", "mm", "cm", "ft", "in"]},
    "coordinate_reference": {"const": "local_cartesian"},
    "width_semantics": {"const": "road_boundary"},
    "left_width": {"type": "number", "exclusiveMinimum": 0},
    "right_width": {"type": "number", "exclusiveMinimum": 0},
    "junction_radius": {"type": "number", "minimum": 0},
    "roads": {"type": "array", "minItems": 1, "maxItems": 200, "items": {
      "type": "object", "required": ["id", "segments"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "direction": {"const": "segment_order"},
        "station_start": {"type": "number"},
        "junction_type": {"enum": ["at_grade", "unknown"]},
        "level": {"type": "integer"},
        "status": {"enum": ["retained", "proposed"]},
        "segments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["line", "arc"]}}}}
      }
    }},
    "constraints": {"type": "array"},
    "context_entities": {"type": "array"}
  }
}
